CREATE DATABASE IF NOT EXISTS the_hub_walle; 
USE the_hub_walle;
CREATE TABLE clientes (    
id INT AUTO_INCREMENT PRIMARY KEY,    
nome_completo VARCHAR(100) NOT NULL,    
cpf VARCHAR(14) UNIQUE NOT NULL,    
email VARCHAR(100),    
telefone VARCHAR(20) 
);

CREATE TABLE usuarios (    
id INT AUTO_INCREMENT PRIMARY KEY,    
nome_completo VARCHAR(100) NOT NULL,    
cpf VARCHAR(14) UNIQUE NOT NULL,    
email VARCHAR(100),    
telefone VARCHAR(20),    
nivel_acesso VARCHAR(50) NOT NULL,
senha VARCHAR(100) NOT NULL);

CREATE TABLE veiculos (   
id INT AUTO_INCREMENT PRIMARY KEY,    
placa VARCHAR(10) UNIQUE NOT NULL,    
modelo VARCHAR(100) NOT NULL,    
ano INT NOT NULL,
cor VARCHAR(50),    
cliente_id INT NOT NULL,    
CONSTRAINT fk_veiculo_cliente FOREIGN KEY (cliente_id) REFERENCES clientes(id) );

CREATE TABLE ordens_servico (    
id INT AUTO_INCREMENT PRIMARY KEY,    
data_agendamento DATETIME NOT NULL,    
box VARCHAR(50),    
status_os VARCHAR(50) NOT NULL, 
veiculo_id INT NOT NULL,    
mecanico_id INT NOT NULL,    
atendente_id INT,    
CONSTRAINT fk_os_veiculo FOREIGN KEY (veiculo_id) REFERENCES veiculos(id),    
CONSTRAINT fk_os_mecanico FOREIGN KEY (mecanico_id) REFERENCES usuarios(id),    
CONSTRAINT fk_os_atendente FOREIGN KEY (atendente_id) REFERENCES usuarios(id) );

CREATE TABLE pecas (    
id INT AUTO_INCREMENT PRIMARY KEY,    
nome_produto VARCHAR(100) NOT NULL,    
categoria VARCHAR(100),    
codigo VARCHAR(50) UNIQUE NOT NULL,    
localizacao VARCHAR(50),    
quantidade INT NOT NULL,    
status_estoque VARCHAR(50) NOT NULL );

CREATE TABLE os_pecas (    
os_id INT NOT NULL,    
peca_id INT NOT NULL,    
quantidade_usada INT NOT NULL,    
preco_unitario DECIMAL(10,2) NOT NULL,    
PRIMARY KEY (os_id, peca_id),    
CONSTRAINT fk_osp_os FOREIGN KEY (os_id) REFERENCES ordens_servico(id),    
CONSTRAINT fk_osp_peca FOREIGN KEY (peca_id) REFERENCES pecas(id) );

